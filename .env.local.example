# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — test keys to start
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Master switch for real payments (client and server both check this).
# Unset/false = payments disabled — the bid/lock buttons show a "check back
# soon" message. Set to "true" only once you're ready to accept real charges.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# Base URL used in generated links (magic links, WhatsApp share cards)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — used to email ownership-confirmation and dashboard-recovery links.
# Get a key at https://resend.com/api-keys. Without a verified sending domain,
# Resend's shared address can only deliver to your own account email, so
# claim-confirmation emails to real owner addresses need a verified domain.
RESEND_API_KEY=
EMAIL_FROM="IndiaBid <onboarding@resend.dev>"
